{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpringCat",
  "version": "0.1.0",
  "identifier": "ai.springcat.app",
  "build": {
    "beforeDevCommand": "pnpm bridge:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bridge:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SpringCat",
        "width": 48,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-blink-features=MiddleClickAutoscroll",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SpringCat",
    "homepage": "https://springcat.cn",
    "copyright": "Copyright © 2026 SpringCat. All rights reserved.",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Desktop AI task notifications",
    "longDescription": "SpringCat keeps AI coding task status visible on your desktop and notifies you when attention is needed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
